{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@motor/core": [
        "packages/core/src/index.ts"
      ],
      "@motor/parser": [
        "packages/parser/src/index.ts"
      ],
      "@motor/tsa": [
        "packages/tsa/src/index.ts"
      ],
      "@motor/tsa/*": [
        "packages/tsa/src/*"
      ],
      "@til/core": [
        "packages/til-core/src/index.ts"
      ],
      "@til/policy": [
        "packages/til-policy/src/index.ts"
      ],
      "@til/adapter-engine": [
        "packages/til-adapter-engine/src/index.ts"
      ],
      "@til/adapter-ui": [
        "packages/til-adapter-ui/src/index.ts"
      ],
      "@til/observe": [
        "packages/til-observe/src/index.ts"
      ]
    }
  },
  "exclude": [
    "workhorse-alias-hardening"
  ]
}
