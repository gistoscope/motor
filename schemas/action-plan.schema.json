{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TIL Action Plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": "til/1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "intentId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "ready", "complete"]
          }
        },
        "required": ["id", "title", "status"]
      }
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "intentId",
    "createdAt",
    "steps"
  ],
  "examples": [
    {
      "protocolVersion": "til/1.0",
      "id": "plan-1",
      "intentId": "intent-1",
      "createdAt": "2024-01-01T00:00:01.000Z",
      "steps": [
        { "id": "step-1", "title": "Highlight target", "status": "ready" },
        { "id": "step-2", "title": "Focus panel", "status": "pending" }
      ]
    }
  ]
}
