{
  "name": "motor-unified-stage1",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "verify": "node scripts/verify-no-web.mjs",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "log2test": "node scripts/log2test.mjs",
    "dev:web": "pnpm --filter @motor/web dev",
    "diag": "node packages/web/demo/server.mjs",
    "start:cli": "pnpm --filter @motor/cli exec motor --demo",
    "prepare": "husky install",
    "cc:record": "node tools/cc-digest/record.mjs",
    "cc:aggregate": "node tools/cc-digest/aggregate.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "happy-dom": "^19.0.2",
    "husky": "^8.0.3",
    "lint-staged": "^16.2.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "workspaces": [
    "packages/cli",
    "packages/core",
    "packages/grasp",
    "packages/parser",
    "packages/tests",
    "packages/tsa",
    "packages/web",
    "packages/micro-viewer"
  ]
}
