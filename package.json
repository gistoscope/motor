{
  "name": "motor-unified-stage1",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "verify": "tsc -p tsconfig.base.json --noEmit",
    "build": "pnpm -r build",
    "test": ":",
    "dev:web": "pnpm --filter @motor/web dev",
    "start:cli": "pnpm --filter @motor/cli exec motor --demo",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "happy-dom": "^19.0.2",
    "jsdom": "workspace:*",
    "husky": "^8.0.3",
    "lint-staged": "^16.2.3",
    "typescript": "^5.5.4",
    "vite-tsconfig-paths": "workspace:^4.3.1",
    "vitest": "^2.0.5"
  }
}
