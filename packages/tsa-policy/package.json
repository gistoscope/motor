{
  "name": "@motor/tsa-policy",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    }
  },
  "files": [
    "dist",
    "src/profiles",
    "src/bundles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --run",
    "ingest": "pnpm run build && node dist/scripts/ingest-tables.js"
  },
  "dependencies": {
    "@motor/types": "workspace:*",
    "@motor/tsa": "workspace:*"
  }
}
