{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@motor/grasp": ["./src/stubs/motor-grasp"],
      "@motor/grasp/*": ["./src/stubs/motor-grasp"],
      "@motor/micro-viewer": ["../micro-viewer/src"],
      "@motor/micro-viewer/*": ["../micro-viewer/src/*"],
      "@motor/tsa": ["./src/stubs/motor-tsa"],
      "@motor/tsa/*": ["./src/stubs/motor-tsa"]
    }
  },
  "include": [
    "src"
  ]
}